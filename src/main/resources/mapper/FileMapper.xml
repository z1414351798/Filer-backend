<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.filer.mapper.FileMapper">
    <resultMap id="fileMap" type="com.filer.model.FileRecord">
        <id property="id" column="id"/>
        <result property="fileId" column="file_id"/>
        <result property="originalName" column="original_name"/>
        <result property="storedName" column="stored_name"/>
        <result property="filePath" column="file_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="mimeType" column="mime_type"/>
        <result property="extension" column="extension"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO file_record(file_id, original_name, stored_name, file_path, file_size, mime_type, extension, user_id, created_at)
        VALUES(#{fileId}, #{originalName}, #{storedName}, #{filePath}, #{fileSize}, #{mimeType}, #{extension}, #{userId}, NOW())
    </insert>

    <select id="findByFileId" resultMap="fileMap">
        SELECT * FROM file_record WHERE file_id = #{fileId} LIMIT 1
    </select>

    <select id="findById" resultMap="fileMap">
        SELECT * FROM file_record WHERE id = #{id} LIMIT 1
    </select>

    <select id="findAll" resultMap="fileMap">
        SELECT * FROM file_record ORDER BY created_at DESC
    </select>

    <select id="findByUserId" resultMap="fileMap">
        SELECT * FROM file_record WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <delete id="deleteByFileId">
        DELETE FROM file_record WHERE file_id = #{fileId}
    </delete>
</mapper>
