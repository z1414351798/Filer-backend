<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.filer.mapper.FileMapper">
    <resultMap id="fileMap" type="com.filer.model.FileRecord">
        <id property="id" column="id"/>
        <result property="fileId" column="file_id"/>
        <result property="originalName" column="original_name"/>
        <result property="contentType" column="content_type"/>
        <result property="size" column="size"/>
        <result property="storagePath" column="storage_path"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO file_record(file_id, original_name, content_type, size, storage_path, user_id, created_at)
        VALUES(#{fileId}, #{originalName}, #{contentType}, #{size}, #{storagePath}, #{userId}, NOW())
    </insert>

    <select id="findByFileId" resultMap="fileMap">
        SELECT * FROM file_record WHERE file_id = #{fileId} LIMIT 1
    </select>

    <select id="findById" resultMap="fileMap">
        SELECT * FROM file_record WHERE id = #{id} LIMIT 1
    </select>

    <select id="findAll" resultMap="fileMap">
        SELECT * FROM file_record ORDER BY created_at DESC
    </select>

    <select id="findByUserId" resultMap="fileMap">
        SELECT * FROM file_record WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>
</mapper>
