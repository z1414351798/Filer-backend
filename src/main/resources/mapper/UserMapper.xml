<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.filer.mapper.UserMapper">
    <resultMap id="userMap" type="com.filer.model.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user`(username, email, password_hash, role, created_at)
        VALUES(#{username}, #{email}, #{passwordHash}, #{role}, NOW())
    </insert>

    <select id="findByEmail" resultMap="userMap">
        SELECT * FROM `user` WHERE email = #{email} LIMIT 1
    </select>

    <select id="findByUsername" resultMap="userMap">
        SELECT * FROM `user` WHERE username = #{username} LIMIT 1
    </select>

    <select id="findById" resultMap="userMap">
        SELECT * FROM `user` WHERE id = #{id} LIMIT 1
    </select>

    <update id="updatePasswordHash">
        UPDATE `user` SET password_hash = #{passwordHash} WHERE id = #{id}
    </update>

    <select id="findAll" resultMap="userMap">
        SELECT * FROM `user` ORDER BY created_at DESC
    </select>
</mapper>
